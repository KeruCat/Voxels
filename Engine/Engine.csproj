<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiligentGraphics.DiligentEngine.Core" Version="2.5.6" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageReference Include="Silk.NET.Input.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Common" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <SlangSource Include="assets\**\*.slang;assets\shaders.json" />
    <None Update="assets\**\*.slang" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <Target Name="CompileShaders" BeforeTargets="BeforeBuild"
          Inputs="@(SlangSource)" Outputs="assets\compiled\voxel.vsh;assets\compiled\voxel.psh">
    <Exec Command="dotnet run --project ..\Tools\ShaderTool -c Release -- build assets\shaders.json"
          ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
