<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>false</SelfContained>
    <AssemblyName>Game</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine\Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <SlangSource Include="Assets\**\*.slang;Assets\shaders.json" />
    <None Update="Assets\**\*.slang" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <Target Name="CompileShaders" BeforeTargets="BeforeBuild"
          Inputs="@(SlangSource)" Outputs="Assets\compiled\voxel.vsh;Assets\compiled\voxel.psh">
    <Exec Command="dotnet run --project ..\Tools\ShaderTool -c Release -- build Assets\shaders.json"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
