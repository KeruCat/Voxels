{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Engine (Vulkan)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Engine/bin/x64/Debug/net10.0/Engine.exe",
      "args": ["--mode", "VK", "--validation"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Engine (D3D12)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Engine/bin/x64/Debug/net10.0/Engine.exe",
      "args": ["--mode", "D3D12", "--validation"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Engine (D3D11)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Engine/bin/x64/Debug/net10.0/Engine.exe",
      "args": ["--mode", "D3D11", "--validation"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Engine (OpenGL)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Engine/bin/x64/Debug/net10.0/Engine.exe",
      "args": ["--mode", "GL", "--validation"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Engine (Vulkan, без лимита FPS и валидации)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Engine/bin/x64/Debug/net10.0/Engine.exe",
      "args": ["--mode", "VK", "--fps", "0"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Engine (Release, выбор API в терминале)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-release",
      "program": "${workspaceFolder}/Engine/bin/x64/Release/net10.0/Engine.exe",
      "args": ["--mode", "${input:graphicsApi}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ],
  "inputs": [
    {
      "id": "graphicsApi",
      "type": "pickString",
      "description": "Графический API",
      "options": ["VK", "D3D12", "D3D11", "GL"],
      "default": "VK"
    }
  ]
}
