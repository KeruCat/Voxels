{
  "dotnet.server.useOmnisharp": false,
  "files.associations": {
    "*.slang": "slang",
    "*.vsh": "hlsl",
    "*.psh": "hlsl"
  },
  "files.exclude": {
    "**/bin": true,
    "**/obj": true
  },
  "files.watcherExclude": {
    "**/bin/**": true,
    "**/obj/**": true
  },
  "dotnet.defaultSolution": "Engine.slnx",
  "editor.formatOnSave": false,
  "[csharp]": { "editor.defaultFormatter": "ms-dotnettools.csharp" }
}
